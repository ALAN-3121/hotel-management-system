# ===== 运行方式一：SQLite（默认，免安装，直接 npm run init && npm start） =====
DB_DRIVER=sqlite

# ===== 运行方式二：MySQL（把下面几行取消注释，并把 DB_DRIVER 改为 mysql） =====
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=你的数据库密码
# DB_NAME=hotel_system

PORT=3000
SESSION_SECRET=yunqi-hotel-dev-secret
